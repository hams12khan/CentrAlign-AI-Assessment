# CentrAlign AI Runtime Configuration
# Copy this file to .env and fill in optional API keys

# LLM Provider Selection: "mock" (100% offline, zero-cost), "groq", "gemini", "ollama"
LLM_PROVIDER=mock

# Free Tier Groq API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Free Tier Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama Settings (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Enterprise Governance Policy Thresholds
APPROVAL_THRESHOLD_AMOUNT=1000.0
DISCREPANCY_TOLERANCE=50.0
MAX_RETRIES_PER_STEP=2
MAX_PARALLEL_WORKERS=4
LOG_LEVEL=INFO
